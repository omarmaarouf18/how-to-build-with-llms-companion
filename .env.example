# Copy to .env and fill in. Never commit .env.
# Every variable the stack needs is listed here, with no real values (Ch. 4.1).

MONGO_INITDB_DATABASE=notification_db
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_mongo_password
REDIS_PASSWORD=CHANGE_ME_redis_password

# Shared with the other services in the full system. Generate long random values:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt_secret
INTERNAL_SERVICE_TOKEN=CHANGE_ME_internal_token

NOTIFICATION_SERVICE_PORT=3004
ALLOWED_ORIGIN=http://localhost:3000
# In the full system this points at auth-service; here nothing listens there.
AUTH_SERVICE_URL=http://localhost:3002

# Optional: Firebase Cloud Messaging. Leave empty and push is disabled cleanly.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_B64=
